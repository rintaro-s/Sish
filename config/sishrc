# Sish設定ファイル
# ~/.sishrc に配置してください

# ========================================
# 言語設定 / Language Configuration
# ========================================
# ja: 日本語 / en: English
: ${SISH_LANG:=ja}

# ========================================
# ショートカット管理と環境変数設定
# ========================================
# Shortcut Management & Environment Variables
export SISH_SHORTCUTS_ENABLED=1
export SISH_COMPLETION_LIMIT=5
export SISH_SHOW_WELCOME=${SISH_SHOW_WELCOME:-1}
export SISH_SHOW_HINT=${SISH_SHOW_HINT:-1}
export SISH_LIVE_COMPLETION_ENABLE=${SISH_LIVE_COMPLETION_ENABLE:-1}
export SISH_LIVE_COMPLETION_MAX_CANDIDATES=${SISH_LIVE_COMPLETION_MAX_CANDIDATES:-5}
export SISH_LLM_AUTO_EXPLAIN=${SISH_LLM_AUTO_EXPLAIN:-0}
export SISH_APT2PACMAN_ENABLE=${SISH_APT2PACMAN_ENABLE:-0}

# Custom environment variables for shortcuts
export SISH_EDITOR="${EDITOR:-nvim}"
export SISH_PAGER="${PAGER:-less}"
export SISH_HOME="${HOME:-~}"
export SISH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sish"
export SISH_HISTORY_FILE="${SISH_HOME}/.sish_history"

# Load internationalization support
if [[ -f "${${(%):-%x}:A:h}/sish_i18n.zsh" ]]; then
    source "${${(%):-%x}:A:h}/sish_i18n.zsh"
fi

# ========================================
# プロンプト設定
# ========================================
sish_setup_prompt 2>/dev/null || PROMPT='%F{213}Sish%f:%F{111}%~%f %# '

# ========================================
# 基本設定
# ========================================
setopt AUTO_CD              # ディレクトリ名だけで移動
unsetopt CORRECT            # コマンド訂正（Sishの提案と競合するので無効）
unsetopt CORRECTALL
setopt NOCORRECT
setopt HIST_IGNORE_DUPS     # 重複履歴を無視
setopt SHARE_HISTORY        # 履歴を共有

# ========================================
# 履歴設定
# ========================================
HISTFILE=~/.sish_history
HISTSIZE=10000
SAVEHIST=10000

# ========================================
# エイリアス
# ========================================
alias ls='ls --color=auto -F'
alias ll='ls --color=auto -lahF'
alias la='ls --color=auto -A'
alias l='ls --color=auto -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Git
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'

# Docker
alias d='docker'
alias dc='docker-compose'

# Python
alias py='python3'
alias ipy='ipython'

# ========================================
# 便利な関数
# ========================================

# 未定義コマンド提案を即実行（次の行で y と打つ）
y() {
    local f="/tmp/sish-last-suggestion-$$"
    local pf=""
    [[ -n "${PPID:-}" ]] && pf="/tmp/sish-last-suggestion-$PPID"

    local pid_for_suggestion="$$"
    local df="/tmp/sish-last-dir-$$"  # ディレクトリ補正用
    local sug=""
    if [[ -n "$pf" && -r "$pf" ]]; then
        pid_for_suggestion="$PPID"
        sug="$(< "$pf")"
        rm -f "$pf" 2>/dev/null || true
    elif [[ -r "$f" ]]; then
        sug="$(< "$f")"
        rm -f "$f" 2>/dev/null || true
    else
        sug="${SISH_LAST_SUGGESTION:-}"
    fi

    if [[ -n "$sug" ]]; then
        # パスタイポ補正（ディレクトリ存在フラグがあれば cd を実行）
        if [[ -r "$df" ]]; then
            local target_dir="$(< "$df")"
            rm -f "$df" 2>/dev/null || true
            if [[ -d "$target_dir" ]]; then
                builtin cd -- "$target_dir"
                return $?
            fi
        fi

        local -a words
        words=( ${(z)sug} )
        if (( ${#words} == 0 )); then
            sish_msg "y_empty_suggestion"
            return 1
        fi

        # 候補がコマンド名だけなら、元コマンドの引数を引き継ぐ
        # 例: `hit clone` -> 候補 `git` -> `git clone`
        if (( ${#words} == 1 )) && (( $# == 0 )); then
            local af="/tmp/sish-last-args-${pid_for_suggestion}"
            if [[ -r "$af" ]]; then
                local -a saved_args
                saved_args=( ${(f)"$(< "$af")"} )
                rm -f "$af" 2>/dev/null || true
                if (( ${#saved_args} )); then
                    "${words[@]}" "${saved_args[@]}"
                    return $?
                fi
            fi

            local prev
            prev="$(fc -ln -2 -2 2>/dev/null || true)"
            if [[ -n "$prev" ]]; then
                local -a prev_words
                prev_words=( ${(z)prev} )
                if (( ${#prev_words} >= 2 )); then
                    "${words[@]}" "${prev_words[@]:1}"
                    return $?
                fi
            fi
        fi

        "${words[@]}" "$@"
    else
        sish_msg "y_no_suggestion"
        return 1
    fi
}

# 追加コマンド
summon() { command git clone -- "$@"; }

# ショートカットは sish-config で設定してください
# Configure shortcuts via sish-config command


void() {
    if [[ $# -lt 1 ]]; then
        sish_msg "void_usage"
        return 2
    fi
    if [[ "$1" == "/" ]]; then
        sish_msg "void_root_warning"
        return 1
    fi
    command rm -rf -- "$@"
}

fiat() {
    if (( EUID == 0 )); then
        command -- "$@"
    else
        sish_msg "fiat_using_sudo"
        command sudo -- "$@"
    fi
}

gaze() { command ls -lahFt --color=auto -- "$@"; }

lore() {
    if [[ $# -ne 1 ]]; then
        sish_msg "lore_usage"
        return 2
    fi
    command cp -a -- "$1" "$1.back"
}

node() {
    # node: first priority (or second if first doesn't exist)
    if [[ $# -lt 1 ]]; then
        sish_msg "node_usage"
        return 2
    fi
    if [[ -d "$1" ]]; then
        builtin cd -- "$1"
        return $?
    fi
    if [[ $# -ge 2 && -d "$2" ]]; then
        builtin cd -- "$2"
        return $?
    fi
    sish_msg "node_not_found"
    return 1
}

genesis() {
    # git init + add + commit "first commit"
    if [[ $# -eq 0 ]]; then
        sish_msg "genesis_usage"
        return 2
    fi
    command mkdir -p -- "$1" || return 1
    builtin cd -- "$1" || return 1
    command git init || return 1
    command git add . || return 1
    command git commit -m "first commit" || return 1
}

oracle() {
    # chmod +x for specified paths
    if [[ $# -lt 1 ]]; then
        sish_msg "oracle_usage"
        return 2
    fi
    command chmod +x -- "$@"
}

# ディレクトリ作成と移動
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# ファイル解凍
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *)           sish_msg "extract_unsupported" "$1" ;;
        esac
    else
        sish_msg "extract_invalid" "$1"
    fi
}


# ========================================
# カスタムコマンド（簡単に追加）
# ========================================
if [[ -f ~/.sish/commands.zsh ]]; then
    source ~/.sish/commands.zsh
fi
if [[ -d ~/.sish/commands.d ]]; then
    for f in ~/.sish/commands.d/*.zsh(N); do
        source "$f"
    done
fi

# ========================================
# ウェルカムメッセージ（対話モードのみ）
# ========================================
if [[ -o interactive ]]; then
    if [[ "${SISH_SHOW_WELCOME:-1}" -eq 1 ]]; then
        sish_msg "welcome"
    fi
    if [[ "${SISH_SHOW_HINT:-1}" -eq 1 ]]; then
        sish_msg "hint_config"
    fi
    if [[ "${SISH_SHOW_WELCOME:-1}" -eq 1 || "${SISH_SHOW_HINT:-1}" -eq 1 ]]; then
        echo ""
    fi
fi
