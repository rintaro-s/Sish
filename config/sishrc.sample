# Sish Configuration File
# This file is sourced after .zshrc
# Place in ~/.sishrc

# ========================================
# Language Configuration / 言語設定
# ========================================
# Language for messages (ja=Japanese, en=English)
# メッセージの言語 (ja=日本語, en=英語)
export SISH_LANG="ja"

# ========================================
# LLM Integration (Optional)
# ========================================
# Uncomment and set to enable LLM features
# export SISH_LLM_ENDPOINT="http://localhost:1234/v1"
# export SISH_LLM_MODEL="local-model"

# ========================================
# Character Customization
# ========================================
# Character name used in messages
export SISH_CHARACTER_NAME="Sish"

# Enable/disable character messages (1=on, 0=off)
export SISH_CHARACTER_ENABLED=1

# ========================================
# Command Suggestions
# ========================================
# Maximum number of suggestions to show
export SISH_MAX_SUGGESTIONS=5

# Maximum Levenshtein distance for suggestions
export SISH_MAX_DISTANCE=3

# ========================================
# GUI Communication
# ========================================
# Socket path for Sish-Console communication
export SISH_SOCKET_PATH="/tmp/sish-console.sock"

# ========================================
# Custom Shortcuts
# ========================================
# Define your own shortcuts here
# Format: alias shortcut='expansion'

# Git shortcuts (additional)
alias gca='git commit --amend'
alias gcane='git commit --amend --no-edit'
alias gri='git rebase -i'
alias gwip='git add -A && git commit -m "WIP"'

# Docker shortcuts (additional)
alias dkl='docker logs -f'
alias dkb='docker build -t'

# Navigation
alias projects='cd ~/Projects'
alias downloads='cd ~/Downloads'

# Quick edits
alias zshrc='${EDITOR:-vim} ~/.zshrc'
alias sishrc='${EDITOR:-vim} ~/.sishrc'

# ========================================
# Functions
# ========================================

# Create directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract various archive formats
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.tar.xz)    tar xJf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "Don't know how to extract '$1'" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Show system info
sysinfo() {
    echo "╔══════════════════════════════════════╗"
    echo "║         System Information           ║"
    echo "╚══════════════════════════════════════╝"
    echo "OS: $(uname -o)"
    echo "Kernel: $(uname -r)"
    echo "Hostname: $(hostname)"
    echo "User: $(whoami)"
    echo "Shell: $SHELL"
    echo "Uptime: $(uptime -p)"
    echo "Memory: $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    echo "Disk: $(df -h / | awk 'NR==2 {print $3 "/" $2}')"
}

# ========================================
# Prompt Customization
# ========================================
# Sish default prompt (override in your .zshrc if desired)
if [[ $SISH_CHARACTER_ENABLED -eq 1 ]]; then
    PROMPT='%F{213}Sish%f %F{cyan}%~%f %(?.%F{green}➜%f.%F{red}➜%f) '
else
    PROMPT='%F{cyan}%~%f %(?.%F{green}➜%f.%F{red}➜%f) '
fi

# ========================================
# Greeting Message
# ========================================
# Shown on shell startup
sish_greeting() {
    local hour=$(date +%H)
    local greeting
    
    if [ $hour -lt 6 ]; then
        greeting="こんな時間まで起きてるの？早く寝なよ〜"
    elif [ $hour -lt 12 ]; then
        greeting="おはよう！今日も一緒にがんばろうね！"
    elif [ $hour -lt 18 ]; then
        greeting="おかえり！午後もがんばって！"
    else
        greeting="お疲れ様！今日もがんばったね！"
    fi
    
    if [[ $SISH_CHARACTER_ENABLED -eq 1 ]]; then
        echo -e "\033[38;5;213m\033[1mSish\033[0m：$greeting"
    fi
}

# Show greeting on startup (can be disabled)
# sish_greeting

# ========================================
# End of Sish Configuration
# ========================================
