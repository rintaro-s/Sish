#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export SISH_REPO_ROOT="$SCRIPT_DIR"

DEFAULT_BUILT_SISH_PATH="$SCRIPT_DIR/zsh-5.9/Src/zsh"
DEFAULT_INSTALLED_SISH_PATH="$SCRIPT_DIR/zsh-5.9/install/bin/zsh"
SISH_BUILD_DIR="$SCRIPT_DIR/zsh-5.9"

pick_sish_binary() {
    if [[ -n "${SISH_PATH:-}" ]]; then
        printf '%s\n' "$SISH_PATH"
        return 0
    fi

    if [[ -x "$DEFAULT_BUILT_SISH_PATH" && -x "$DEFAULT_INSTALLED_SISH_PATH" ]]; then
        if [[ "$DEFAULT_BUILT_SISH_PATH" -nt "$DEFAULT_INSTALLED_SISH_PATH" ]]; then
            printf '%s\n' "$DEFAULT_BUILT_SISH_PATH"
        else
            printf '%s\n' "$DEFAULT_INSTALLED_SISH_PATH"
        fi
        return 0
    fi

    if [[ -x "$DEFAULT_BUILT_SISH_PATH" ]]; then
        printf '%s\n' "$DEFAULT_BUILT_SISH_PATH"
        return 0
    fi

    if [[ -x "$DEFAULT_INSTALLED_SISH_PATH" ]]; then
        printf '%s\n' "$DEFAULT_INSTALLED_SISH_PATH"
        return 0
    fi

    return 1
}

sish_binary_stale() {
    local bin="$1"
    [[ -n "$bin" && -x "$bin" ]] || return 0

    find "$SISH_BUILD_DIR/Src" "$SISH_BUILD_DIR/Config" \
        -type f \( -name '*.c' -o -name '*.h' -o -name '*.mdd' -o -name '*.mk' -o -name 'Makefile*' \) \
        -newer "$bin" -print -quit 2>/dev/null | grep -q .
}

sish_try_build() {
    [[ -d "$SISH_BUILD_DIR" ]] || return 1
    command -v make >/dev/null 2>&1 || return 1

    local jobs="${SISH_BUILD_JOBS:-}"
    if [[ -z "$jobs" ]]; then
        jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
    fi
    [[ "$jobs" =~ ^[0-9]+$ ]] || jobs=4
    (( jobs < 1 )) && jobs=1

    make -C "$SISH_BUILD_DIR" -j"$jobs"
}

# Allow overriding the zsh binary path.
# Prefer an explicit env var, then the newer of (in-repo build artifact, in-repo install).
SISH_PATH="$(pick_sish_binary 2>/dev/null || true)"
SISH_CONFIG="$SCRIPT_DIR/config/sishrc"

# Default language
: ${SISH_LANG:=ja}

if [[ "${SISH_AUTO_BUILD:-1}" -eq 1 ]]; then
    if [[ -z "$SISH_PATH" || ! -x "$SISH_PATH" ]]; then
        if ! sish_try_build; then
            if [[ "$SISH_LANG" == "en" ]]; then
                echo "Sish: automatic rebuild failed." >&2
                echo "Hint: Run make in $SISH_BUILD_DIR (or set SISH_PATH=/path/to/zsh)" >&2
            else
                echo "Sish: 自動再ビルドに失敗したよ。" >&2
                echo "ヒント: $SISH_BUILD_DIR で make を実行してね（または SISH_PATH=/path/to/zsh を設定）" >&2
            fi
            exit 127
        fi
        SISH_PATH="$(pick_sish_binary 2>/dev/null || true)"
    elif sish_binary_stale "$SISH_PATH"; then
        if ! sish_try_build; then
            if [[ "$SISH_LANG" == "en" ]]; then
                echo "Sish: automatic rebuild failed." >&2
                echo "Hint: Run make in $SISH_BUILD_DIR (or set SISH_PATH=/path/to/zsh)" >&2
            else
                echo "Sish: 自動再ビルドに失敗したよ。" >&2
                echo "ヒント: $SISH_BUILD_DIR で make を実行してね（または SISH_PATH=/path/to/zsh を設定）" >&2
            fi
            exit 127
        fi
        SISH_PATH="$(pick_sish_binary 2>/dev/null || true)"
    fi
fi

if [[ ! -x "$SISH_PATH" ]]; then
    if [[ "$SISH_LANG" == "en" ]]; then
        echo "Sish: Executable not found: $SISH_PATH" >&2
        echo "Hint: Run make in $SCRIPT_DIR/zsh-5.9 (or set SISH_PATH=/path/to/zsh)" >&2
    else
        echo "Sish: 実行ファイルが見つからないよ: $SISH_PATH" >&2
        echo "ヒント: $SCRIPT_DIR/zsh-5.9 で make を実行してね（または SISH_PATH=/path/to/zsh を設定）" >&2
    fi
    exit 127
fi

# zshは「rcファイルのパスを引数で渡す」仕様ではないので、
# ZDOTDIRに隔離した .zshrc を用意して、対話シェルとして起動する。
DOTDIR="$(mktemp -d)"
cleanup() {
    rm -rf "$DOTDIR" 2>/dev/null || true
}
trap cleanup EXIT

cat > "$DOTDIR/.zshrc" << 'EOFRC'
# Sish temporary .zshrc (isolated via ZDOTDIR)

# Ensure zsh modules (e.g., zsh/zle) can be loaded even when zsh is not installed system-wide.
# This is replaced by the launcher with an in-repo module directory when available.
if [[ -n "${SISH_ZSH_MODULE_DIR:-}" && -d "$SISH_ZSH_MODULE_DIR" ]]; then
    module_path=("$SISH_ZSH_MODULE_DIR" "${module_path[@]}")
fi

# Set i18n path for the embedded zsh session
export SISH_I18N_PATH="SISH_I18N_PATH_PLACEHOLDER"

# 環境変数で既に設定されている値を保護
typeset -A sish_env_overrides
for var in SISH_LANG SISH_TONE SISH_THEME SISH_ERROR_VERBOSITY \
           SISH_CHAR_NAME SISH_CHAR_EXPRESSION SISH_CHAR_POSITION SISH_CHAR_SIZE SISH_CHAR_ANIMATION \
           SISH_SHOW_WELCOME SISH_SHOW_HINT \
           SISH_LIVE_COMPLETION_ENABLE SISH_LIVE_COMPLETION_MAX_CANDIDATES \
           SISH_COMPLETION_ENABLE SISH_COMPLETION_FUZZY SISH_COMPLETION_MAX_CANDIDATES \
           SISH_COMPLETION_DIR_SIMILARITY SISH_COMPLETION_HISTORY \
           SISH_LLM_ENABLE SISH_LLM_ENDPOINT SISH_LLM_MODEL SISH_LLM_MAX_TOKENS SISH_LLM_AUTO_EXPLAIN SISH_LLM_RESPONSE_LANG \
           SISH_GUI_ENABLE SISH_GUI_SOCKET_PATH SISH_GUI_AUTOSTART SISH_GUI_EXPRESSION_SYNC \
           SISH_APT2PACMAN_ENABLE; do
    if [[ -n "${(P)var:-}" ]]; then
        sish_env_overrides[$var]="${(P)var}"
    fi
done

# Load internationalization support
# First check user's .sish directory, then fall back to the script's config directory
if [[ -f "$HOME/.sish/i18n.zsh" ]]; then
    source "$HOME/.sish/i18n.zsh"
elif [[ -n "${SISH_I18N_PATH:-}" && -f "$SISH_I18N_PATH" ]]; then
    source "$SISH_I18N_PATH"
fi

# 環境変数で指定された値で上書き
for var in "${(@k)sish_env_overrides}"; do
    # zshの予約変数（status等）は上書きできないのでスキップ
    [[ "$var" == "status" ]] && continue
    export "$var=${sish_env_overrides[$var]}" 2>/dev/null || true
done

setopt AUTO_CD
unsetopt CORRECT
unsetopt CORRECTALL
setopt NOCORRECT
setopt HIST_IGNORE_DUPS
setopt SHARE_HISTORY

HISTFILE=~/.sish_history
HISTSIZE=10000
SAVEHIST=10000

# Setup prompt (can be customized per language)
if type sish_setup_prompt >/dev/null 2>&1; then
    sish_setup_prompt
else
    PROMPT='%F{213}Sish%f:%F{111}%~%f %# '
fi

# 補完（Tab）
if [[ -o interactive ]]; then
    autoload -Uz compinit 2>/dev/null
    () {
        emulate -L zsh
        setopt localoptions nonomatch
        compinit -C -d ~/.sish_compdump 2>/dev/null || true
    }
fi

# zsh-hook補完（エラーを抑制）
autoload -Uz add-zsh-hook 2>/dev/null

# ========================================
# リアルタイム補完（入力中の候補表示）
# ========================================
_sish_live_completion_update() {
    emulate -L zsh
    setopt localoptions nonomatch nullglob
    [[ "${SISH_LIVE_COMPLETION_ENABLE:-1}" -eq 1 ]] || { POSTDISPLAY=""; return 0; }

    local buf="$BUFFER"
    local cur=$CURSOR
    local left="${buf[1,cur]}"
    local word="${left##* }"

    if [[ -z "$word" ]]; then
        POSTDISPLAY=""
        return 0
    fi

    local -a candidates=()
    if [[ "$word" == */* || "$word" == ~* || "$word" == .* ]]; then
        local pattern="${word}*"
        candidates=(${~pattern}(N))
    else
        local -a all
        all=(${(k)commands} ${(k)builtins} ${(k)functions} ${(k)aliases})
        typeset -aU all
        local c
        for c in $all; do
            [[ "$c" == ${word}* ]] && candidates+="$c"
        done
    fi

    if (( ${#candidates} == 0 )); then
        POSTDISPLAY=""
        return 0
    fi

    local max=${SISH_LIVE_COMPLETION_MAX_CANDIDATES:-5}
    (( max < 1 )) && max=1
    (( max > 100 )) && max=100

    local -a show=()
    local item
    for item in ${candidates[1,max]}; do
        if [[ -d "$item" ]]; then
            show+="$item/"
        else
            show+="$item"
        fi
    done

    local joined="${(j: :)show}"
    if [[ "${SISH_LANG:-ja}" == "en" ]]; then
        POSTDISPLAY=$'\nCandidates: '"$joined"
    else
        POSTDISPLAY=$'\n候補: '"$joined"
    fi
}

if [[ -o interactive && "${SISH_LIVE_COMPLETION_ENABLE:-1}" -eq 1 ]]; then
    # 入力行の再描画時に候補を更新
    zle -N zle-line-pre-redraw _sish_live_completion_update 2>/dev/null || true
fi

command_not_found_handler() {
    local missing="$1"
    shift || true

    local suggestion=""
    if [[ -n "${aliases[g]:-}" && "$missing" == "gti" ]]; then
        suggestion="git"
    fi

    if [[ -z "$suggestion" ]]; then
        case "$missing" in
            gti|gut|got)
                suggestion="git"
                ;;
            pnpmm|pnmp)
                suggestion="pnpm"
                ;;
            pyhton|pythno)
                suggestion="python3"
                ;;
            nvimm|nvim)
                suggestion="nvim"
                ;;
        esac
    fi

    if [[ -z "$suggestion" ]]; then
        local prefix="${missing[1,2]:l}"
        local candidate
        for candidate in ${(k)commands}; do
            if [[ "${candidate:l}" == ${prefix}* ]]; then
                suggestion="$candidate"
                break
            fi
        done
    fi

    if [[ -n "$suggestion" ]]; then
        SISH_LAST_SUGGESTION="$suggestion"
        print -r -- "$suggestion" >| "/tmp/sish-last-suggestion-$$" 2>/dev/null || true
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "cmd_not_found" "$missing" "$suggestion"
        else
            print -r -- "Sish：お兄ちゃん！\"$missing\" は無いよ… もしかして \"$suggestion\"？"
            print -r -- "       候補をそのまま実行するなら y を押してね"
        fi
    else
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "cmd_not_found_no_suggestion" "$missing"
        else
            print -r -- "Sish：\"$missing\" は見つからなかったよ…"
        fi
    fi
    return 127
}

# cd補正フック: ディレクトリが見つからないときに補正候補を表示
cd_with_correction() {
    builtin cd "$@" 2>/dev/null && return 0
    
    # cdが失敗した場合、補正候補を探す
    local target="$1"
    if [[ -n "$target" && "$target" != -* ]]; then
        # パスにスラッシュが含まれる場合（例: zsh-/Doc, zsh-5.6/Doc）
        if [[ "$target" == */* ]]; then
            local first_part="${target%%/*}"    # 最初の部分（例: zsh-）
            local rest_part="${target#*/}"      # 残りの部分（例: Doc）
            
            local -a first_candidates=()
            local dir
            for dir in "$PWD"/*; do
                if [[ -d "$dir" ]]; then
                    local dirname="${dir##*/}"
                    local first_lower="${first_part:l}"
                    local dirname_lower="${dirname:l}"
                    if [[ "$dirname" == "$first_part" ]] || \
                       [[ "$dirname_lower" == "$first_lower" ]] || \
                       [[ "$dirname_lower" == *"$first_lower"* ]] || \
                       [[ "$first_lower" == *"$dirname_lower"* ]] || \
                       [[ "$dirname_lower" =~ ^"$first_lower" ]] || \
                       [[ "$dirname_lower" =~ "$first_lower"$ ]]; then
                        first_candidates+=("$dir")
                    fi
                fi
            done
            
            # 最初の部分の候補が見つかった場合、残りのパスと結合
            if (( ${#first_candidates} >= 1 )); then
                local -a full_candidates=()
                for base in "${first_candidates[@]}"; do
                    local full_path="$base/$rest_part"
                    if [[ -d "$full_path" ]]; then
                        full_candidates+=("$full_path")
                    fi
                done
                
                if (( ${#full_candidates} == 1 )); then
                    echo "${full_candidates[1]}" > "/tmp/sish-last-dir-$$"
                    builtin cd "${full_candidates[1]}"
                    return $?
                elif (( ${#full_candidates} > 1 )); then
                    local cand="${full_candidates[1]}"
                    echo "$cand" > "/tmp/sish-last-dir-$$"
                    if type sish_msg >/dev/null 2>&1; then
                        sish_msg "dir_not_found_maybe" "$target" "${cand#$PWD/}"
                    else
                        print -r -- "Sish：お兄ちゃん！「$target」は無かったよ… もしかして「${cand#$PWD/}」のこと？"
                    fi
                    return 1
                fi
            fi
        fi
        
        # 通常のパス（スラッシュなし）
        local -a candidates=()
        local dir
        for dir in "$PWD"/*; do
            if [[ -d "$dir" ]]; then
                local dirname="${dir##*/}"
                local target_lower="${target:l}"
                local dirname_lower="${dirname:l}"
                if [[ "$dirname" == "$target" ]] || \
                   [[ "$dirname_lower" == "$target_lower" ]] || \
                   [[ "$dirname_lower" == *"$target_lower"* ]] || \
                   [[ "$target_lower" == *"$dirname_lower"* ]] || \
                   [[ "$dirname_lower" =~ ^"$target_lower" ]] || \
                   [[ "$dirname_lower" =~ "$target_lower"$ ]]; then
                    candidates+=("$dir")
                fi
            fi
        done
        
        if (( ${#candidates} == 1 )); then
            echo "${candidates[1]}" > "/tmp/sish-last-dir-$$"
            builtin cd "${candidates[1]}"
            return $?
        elif (( ${#candidates} > 1 )); then
            local cand="${candidates[1]}"
            echo "$cand" > "/tmp/sish-last-dir-$$"
            if type sish_msg >/dev/null 2>&1; then
                sish_msg "dir_not_found" "$target" "${cand##*/}"
                sish_msg "dir_similar_folders" "${cand##*/}"
                sish_msg "dir_hint"
            else
                print -r -- "Sish：お兄ちゃん！「$target」は無かったよ… 「${cand##*/}」の間違いじゃない？"
                print -r -- "       それっぽいフォルダ: ${cand##*/}"
                print -r -- "       ヒント: パスを確認してね！"
            fi
            return 1
        fi
    fi
    
    # 補正できなかった場合は元のエラーで返す
    builtin cd "$@"
    return $?
}

alias cd='cd_with_correction'

# ========================================
# Apt2Pacman変換機能
# ========================================
apt() {
    # 機能が無効なら通常のaptを実行
    if [[ "${SISH_APT2PACMAN_ENABLE:-0}" -ne 1 ]]; then
        command apt "$@"
        return $?
    fi
    
    if [[ $# -eq 0 ]]; then
        command apt
        return $?
    fi
    
    case "$1" in
        update|upgrade)
            echo " Sish: Converting 'apt $1' → 'pacman -Syu'"
            shift
            pacman -Syu "$@"
            ;;
        install)
            shift
            echo " Sish: Converting 'apt install' → 'pacman -S'"
            pacman -S "$@"
            ;;
        remove|uninstall)
            shift
            echo " Sish: Converting 'apt remove' → 'pacman -R'"
            pacman -R "$@"
            ;;
        search)
            shift
            echo " Sish: Converting 'apt search' → 'pacman -Ss'"
            pacman -Ss "$@"
            ;;
        *)
            echo " Sish: Unknown apt command '$1', running as-is"
            command apt "$@"
            ;;
    esac
}

sudo() {
    # apt関連の場合のみ変換をチェック
    if [[ $# -ge 2 && "$1" == "apt" && "${SISH_APT2PACMAN_ENABLE:-0}" -eq 1 ]]; then
        shift
        case "$1" in
            update|upgrade)
                echo " Sish: Converting 'sudo apt $1' → 'sudo pacman -Syu'"
                shift
                command sudo pacman -Syu "$@"
                ;;
            install)
                shift
                echo " Sish: Converting 'sudo apt install' → 'sudo pacman -S'"
                command sudo pacman -S "$@"
                ;;
            remove|uninstall)
                shift
                echo " Sish: Converting 'sudo apt remove' → 'sudo pacman -R'"
                command sudo pacman -R "$@"
                ;;
            search)
                shift
                echo " Sish: Converting 'sudo apt search' → 'pacman -Ss'"
                pacman -Ss "$@"
                ;;
            *)
                echo " Sish: Unknown apt command '$1', running as-is"
                command sudo apt "$@"
                ;;
        esac
    else
        command sudo "$@"
    fi
}

# 未定義コマンド提案を即実行
y() {
    local f="/tmp/sish-last-suggestion-$$"
    local pf=""
    [[ -n "${PPID:-}" ]] && pf="/tmp/sish-last-suggestion-$PPID"

    local pid_for_suggestion="$$"
    local df="/tmp/sish-last-dir-$$"  # ディレクトリ補正用
    local sug=""
    
    # パスタイポ補正フラグを優先チェック（ディレクトリ補正）
    if [[ -r "$df" ]]; then
        local target_dir="$(< "$df")"
        rm -f "$df" 2>/dev/null || true
        if [[ -d "$target_dir" ]]; then
            builtin cd -- "$target_dir"
            return $?
        fi
    fi
    
    if [[ -n "$pf" && -r "$pf" ]]; then
        pid_for_suggestion="$PPID"
        sug="$(< "$pf")"
        rm -f "$pf" 2>/dev/null || true
    elif [[ -r "$f" ]]; then
        sug="$(< "$f")"
        rm -f "$f" 2>/dev/null || true
    else
        sug="${SISH_LAST_SUGGESTION:-}"
    fi

    if [[ -n "$sug" ]]; then
        local -a words
        # Split like a shell command line, without evaluating it.
        words=( ${(z)sug} )
        if (( ${#words} == 0 )); then
            if type sish_msg >/dev/null 2>&1; then
                sish_msg "y_empty_suggestion"
            else
                print -r -- "Sish：お兄ちゃん、候補が空っぽだった…"
            fi
            return 1
        fi

        # If suggestion is only a command name, inherit args from the original command.
        # Example: `hit clone` -> suggestion `git` -> run `git clone`.
        if (( ${#words} == 1 )) && (( $# == 0 )); then
            local af="/tmp/sish-last-args-${pid_for_suggestion}"
            if [[ -r "$af" ]]; then
                local -a saved_args
                saved_args=( ${(f)"$(< "$af")"} )
                rm -f "$af" 2>/dev/null || true
                if (( ${#saved_args} )); then
                    "${words[@]}" "${saved_args[@]}"
                    return $?
                fi
            fi

            local prev
            prev="$(fc -ln -2 -2 2>/dev/null || true)"
            if [[ -n "$prev" ]]; then
                local -a prev_words
                prev_words=( ${(z)prev} )
                if (( ${#prev_words} >= 2 )); then
                    "${words[@]}" "${prev_words[@]:1}"
                    return $?
                fi
            fi
        fi

        "${words[@]}" "$@"
    else
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "y_no_suggestion"
        else
            print -r -- "Sish：お兄ちゃん、いま実行できる候補が無いよ…"
        fi
        return 1
    fi
}

# --- Path fixups for famous commands ---
_sish_first_existing_candidate() {
    setopt local_options NULL_GLOB NO_CASE_GLOB
    local base="$1"
    local -a cands
    # Prefer exact-with-extension (README -> README.md etc), then prefix.
    # Try current dir, then one and two levels up.
    local -a prefixes
    prefixes=("" "../" "../../")
    local p
    for p in "${prefixes[@]}"; do
        cands=( ${p}${base}.* )
        if (( ${#cands} == 0 )); then
            cands=( ${p}${base}* )
        fi
        if (( ${#cands} )); then
            print -r -- "${cands[1]}"
            return 0
        fi
    done
    if (( ${#cands} )); then
        print -r -- "${cands[1]}"
        return 0
    fi
    return 1
}

cat() {
    local -a opts files
    local a
    for a in "$@"; do
        if [[ "$a" == -* ]]; then
            opts+=("$a")
        else
            files+=("$a")
        fi
    done

    if (( ${#files} == 1 )) && [[ ! -e "${files[1]}" ]]; then
        local cand
        cand="$(_sish_first_existing_candidate "${files[1]}")" || {
            command cat "$@"
            return $?
        }
        # Suggest running the corrected path via `y`.
        if (( ${#opts} )); then
            SISH_LAST_SUGGESTION="cat ${(j: :)${(q)opts}} ${(q)cand}"
        else
            SISH_LAST_SUGGESTION="cat ${(q)cand}"
        fi
        # Use the same per-process temp file that `y` consumes, to avoid stale suggestions.
        print -r -- "$SISH_LAST_SUGGESTION" >| "/tmp/sish-last-suggestion-$$" 2>/dev/null || true
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "void_file_not_found" "${files[1]}" "$cand"
        else
            print -r -- "Sish：お兄ちゃん！\"${files[1]}\" は無かったよ… もしかして\"$cand\" のこと？"
        fi
        return 1
    fi

    command cat "$@"
}

# 便利コマンド（デフォルト）
summon() { command git clone -- "$@"; }

void() {
    if [[ $# -lt 1 ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "void_usage"
        else
            print -r -- "Sish：お兄ちゃん、voidは消したいパスを指定してね！（例: void ./tmp）"
        fi
        return 2
    fi
    if [[ "$1" == "/" ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "void_root_warning"
        else
            print -r -- "Sish：それはダメ！ '/' は消しちゃだめ！"
        fi
        return 1
    fi
    command rm -rf -- "$@"
}

fiat() {
    if (( EUID == 0 )); then
        command -- "$@"
    else
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "fiat_using_sudo"
        else
            print -r -- "Sish：お兄ちゃん、fiatはSishが管理者で動いてる時だけパスワードレスだよ…（sudoで実行するね）"
        fi
        command sudo -- "$@"
    fi
}

gaze() { command ls -lahFt --color=auto -- "$@"; }

lore() {
    if [[ $# -ne 1 ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "lore_usage"
        else
            print -r -- "Sish：loreは1つだけ指定してね！（例: lore myfile）"
        fi
        return 2
    fi
    command cp -a -- "$1" "$1.back"
}

node() {
    if [[ $# -lt 1 ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "node_usage"
        else
            print -r -- "Sish：nodeは2つの候補ディレクトリを渡してね！（例: node hoge foo）"
        fi
        return 2
    fi
    if [[ -d "$1" ]]; then
        builtin cd -- "$1"
        return $?
    fi
    if [[ $# -ge 2 && -d "$2" ]]; then
        builtin cd -- "$2"
        return $?
    fi
    if type sish_msg >/dev/null 2>&1; then
        sish_msg "node_not_directory"
    else
        print -r -- "Sish：お兄ちゃん、どっちもフォルダじゃなかった…"
    fi
    return 1
}

