#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

DEFAULT_BUILT_SISH_PATH="$SCRIPT_DIR/zsh-5.9/Src/zsh"
DEFAULT_INSTALLED_SISH_PATH="$SCRIPT_DIR/zsh-5.9/install/bin/zsh"

# Allow overriding the zsh binary path.
# Prefer an explicit env var, then the newer of (in-repo build artifact, in-repo install).
SISH_PATH="${SISH_PATH:-}"
if [[ -z "$SISH_PATH" ]]; then
    if [[ -x "$DEFAULT_BUILT_SISH_PATH" && -x "$DEFAULT_INSTALLED_SISH_PATH" ]]; then
        if [[ "$DEFAULT_BUILT_SISH_PATH" -nt "$DEFAULT_INSTALLED_SISH_PATH" ]]; then
            SISH_PATH="$DEFAULT_BUILT_SISH_PATH"
        else
            SISH_PATH="$DEFAULT_INSTALLED_SISH_PATH"
        fi
    elif [[ -x "$DEFAULT_BUILT_SISH_PATH" ]]; then
        SISH_PATH="$DEFAULT_BUILT_SISH_PATH"
    elif [[ -x "$DEFAULT_INSTALLED_SISH_PATH" ]]; then
        SISH_PATH="$DEFAULT_INSTALLED_SISH_PATH"
    fi
fi
SISH_CONFIG="$SCRIPT_DIR/config/sishrc"

# Default language
: ${SISH_LANG:=ja}

if [[ ! -x "$SISH_PATH" ]]; then
    if [[ "$SISH_LANG" == "en" ]]; then
        echo "Sish: Executable not found: $SISH_PATH" >&2
        echo "Hint: Run make in $SCRIPT_DIR/zsh-5.9 (or set SISH_PATH=/path/to/zsh)" >&2
    else
        echo "Sish: 実行ファイルが見つからないよ: $SISH_PATH" >&2
        echo "ヒント: $SCRIPT_DIR/zsh-5.9 で make を実行してね（または SISH_PATH=/path/to/zsh を設定）" >&2
    fi
    exit 127
fi

# zshは「rcファイルのパスを引数で渡す」仕様ではないので、
# ZDOTDIRに隔離した .zshrc を用意して、対話シェルとして起動する。
DOTDIR="$(mktemp -d)"
cleanup() {
    rm -rf "$DOTDIR" 2>/dev/null || true
}
trap cleanup EXIT

cat > "$DOTDIR/.zshrc" << 'EOFRC'
# Sish temporary .zshrc (isolated via ZDOTDIR)

# Ensure zsh modules (e.g., zsh/zle) can be loaded even when zsh is not installed system-wide.
# This is replaced by the launcher with an in-repo module directory when available.
if [[ -n "${SISH_ZSH_MODULE_DIR:-}" && -d "$SISH_ZSH_MODULE_DIR" ]]; then
    module_path=("$SISH_ZSH_MODULE_DIR" $module_path)
fi

# Set i18n path for the embedded zsh session
export SISH_I18N_PATH="SISH_I18N_PATH_PLACEHOLDER"

# 環境変数で既に設定されている値を保護
typeset -A sish_env_overrides
for var in SISH_LANG SISH_TONE SISH_THEME SISH_ERROR_VERBOSITY \
           SISH_CHAR_NAME SISH_CHAR_EXPRESSION SISH_CHAR_POSITION SISH_CHAR_SIZE SISH_CHAR_ANIMATION \
           SISH_SHOW_WELCOME SISH_SHOW_HINT \
           SISH_LIVE_COMPLETION_ENABLE SISH_LIVE_COMPLETION_MAX_CANDIDATES \
           SISH_COMPLETION_ENABLE SISH_COMPLETION_FUZZY SISH_COMPLETION_MAX_CANDIDATES \
           SISH_COMPLETION_DIR_SIMILARITY SISH_COMPLETION_HISTORY \
           SISH_LLM_ENABLE SISH_LLM_ENDPOINT SISH_LLM_MODEL SISH_LLM_MAX_TOKENS SISH_LLM_AUTO_EXPLAIN \
           SISH_GUI_ENABLE SISH_GUI_SOCKET_PATH SISH_GUI_AUTOSTART SISH_GUI_EXPRESSION_SYNC \
           SISH_APT2PACMAN_ENABLE; do
    if [[ -n "${(P)var:-}" ]]; then
        sish_env_overrides[$var]="${(P)var}"
    fi
done

# Load internationalization support
# First check user's .sish directory, then fall back to the script's config directory
if [[ -f "$HOME/.sish/i18n.zsh" ]]; then
    source "$HOME/.sish/i18n.zsh"
elif [[ -n "${SISH_I18N_PATH:-}" && -f "$SISH_I18N_PATH" ]]; then
    source "$SISH_I18N_PATH"
fi

# 環境変数で指定された値で上書き
for var in "${(@k)sish_env_overrides}"; do
    # zshの予約変数（status等）は上書きできないのでスキップ
    [[ "$var" == "status" ]] && continue
    export "$var=${sish_env_overrides[$var]}" 2>/dev/null || true
done

setopt AUTO_CD
unsetopt CORRECT
unsetopt CORRECTALL
setopt NOCORRECT
setopt HIST_IGNORE_DUPS
setopt SHARE_HISTORY

HISTFILE=~/.sish_history
HISTSIZE=10000
SAVEHIST=10000

# Setup prompt (can be customized per language)
if type sish_setup_prompt >/dev/null 2>&1; then
    sish_setup_prompt
else
    PROMPT='%F{213}Sish%f:%F{111}%~%f %# '
fi

# 補完（Tab）
# Debian環境でのハング対策：compinit を軽量モードで実行
autoload -Uz compinit 2>/dev/null
if [[ -f ~/.sish_compdump && $(stat -c %Y ~/.sish_compdump 2>/dev/null || echo 0) -gt $(($(date +%s) - 86400)) ]]; then
    compinit -C -d ~/.sish_compdump 2>/dev/null || true
else
    # 新規または1日以上古い場合のみ更新
    (timeout 5 compinit -d ~/.sish_compdump >/dev/null 2>&1 &)
fi

# zsh-hook補完（エラーを抑制）
autoload -Uz add-zsh-hook 2>/dev/null

# ========================================
# リアルタイム補完（入力中の候補表示）
# ========================================
_sish_live_completion_update() {
    [[ "${SISH_LIVE_COMPLETION_ENABLE:-1}" -eq 1 ]] || { zle -M ""; return 0; }

    local buf="$BUFFER"
    local cur=$CURSOR
    local left="${buf[1,cur]}"
    local word="${left##* }"

    if [[ -z "$word" ]]; then
        zle -M ""
        return 0
    fi

    local -a candidates=()
    if [[ "$word" == */* || "$word" == ~* || "$word" == .* ]]; then
        local pattern="${word}*"
        candidates=(${~pattern}(N))
    else
        local -a all
        all=(${(k)commands} ${(k)builtins} ${(k)functions} ${(k)aliases})
        typeset -aU all
        local c
        for c in $all; do
            [[ "$c" == ${word}* ]] && candidates+="$c"
        done
    fi

    if (( ${#candidates} == 0 )); then
        zle -M ""
        return 0
    fi

    local max=${SISH_LIVE_COMPLETION_MAX_CANDIDATES:-5}
    (( max < 1 )) && max=1
    (( max > 100 )) && max=100

    local -a show=()
    local item
    for item in ${candidates[1,max]}; do
        if [[ -d "$item" ]]; then
            show+="$item/"
        else
            show+="$item"
        fi
    done

    if [[ "${SISH_LANG:-ja}" == "en" ]]; then
        zle -M "Candidates: ${show[*]}"
    else
        zle -M "候補: ${show[*]}"
    fi
}

if [[ -o interactive && "${SISH_LIVE_COMPLETION_ENABLE:-1}" -eq 1 ]]; then
    # Debian環境ではzleイベントが重いため、条件を厳しくする
    zle -N zle-line-pre-redraw _sish_live_completion_update 2>/dev/null || true
fi

# ========================================
# LLM 統合（簡易フロント）
# ========================================
_sish_llm_call() {
    if [[ -z "$*" ]]; then
        if [[ "${SISH_LANG:-ja}" == "en" ]]; then
            echo "Usage: sish-llm <prompt>"
        else
            echo "使い方: sish-llm <prompt>"
        fi
        return 2
    fi

    if [[ "${SISH_LLM_ENABLE:-0}" -ne 1 ]]; then
        if [[ "${SISH_LANG:-ja}" == "en" ]]; then
            echo "LLM integration is disabled. Enable it in sish-config."
        else
            echo "LLM統合が無効です。sish-config で有効にしてください。"
        fi
        return 1
    fi

    if [[ -z "${SISH_LLM_ENDPOINT:-}" ]]; then
        if [[ "${SISH_LANG:-ja}" == "en" ]]; then
            echo "SISH_LLM_ENDPOINT is not set."
        else
            echo "SISH_LLM_ENDPOINT が設定されていません。"
        fi
        return 1
    fi

    if ! command -v curl >/dev/null 2>&1; then
        echo "curl が必要です。"
        return 127
    fi

    local prompt="$*"
    local model="${SISH_LLM_MODEL:-default}"
    local max_tokens="${SISH_LLM_MAX_TOKENS:-2000}"
    local escaped="$prompt"
    escaped=${escaped//\\/\\\\}
    escaped=${escaped//"/\\"}
    escaped=${escaped//$'\n'/\\n}

    local payload
    payload="{\"model\": \"$model\", \"messages\": [{\"role\": \"user\", \"content\": \"$escaped\"}], \"max_tokens\": $max_tokens}"

    local url
    if [[ "${SISH_LLM_ENDPOINT}" == */v1* ]]; then
        url="${SISH_LLM_ENDPOINT}/chat/completions"
    else
        url="${SISH_LLM_ENDPOINT}/v1/chat/completions"
    fi

    local response
    response=$(curl --fail --silent --show-error \
        --connect-timeout 5 --max-time 20 \
        -H 'Content-Type: application/json' \
        -X POST "$url" \
        -d "$payload" 2>/dev/null)

    if [[ -z "$response" ]]; then
        if [[ "${SISH_LANG:-ja}" == "en" ]]; then
            echo "No response from LLM."
        else
            echo "LLMから応答がありません。"
        fi
        return 1
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 - << 'PY' <<< "$response"
import json,sys
try:
    data=json.load(sys.stdin)
    msg=data.get('choices',[{}])[0].get('message',{}).get('content','')
    print(msg.strip())
except Exception:
    print(sys.stdin.read())
PY
    else
        echo "$response" | sed -n 's/.*"content":"\(.*\)".*/\1/p' | sed 's/\\n/\n/g'
    fi
}

sish-llm() {
    _sish_llm_call "$@"
}

alias llm='sish-llm'

_sish_llm_explain_last() {
    local cmd="$SISH_LAST_CMD"
    local exit_code="$SISH_LAST_STATUS"
    local pwd="$SISH_LAST_PWD"

    if [[ -z "$cmd" || -z "$exit_code" ]]; then
        return 1
    fi

    local prompt
    if [[ "${SISH_LANG:-ja}" == "en" ]]; then
        prompt="Explain why this command failed.\nCommand: $cmd\nExit code: $exit_code\nDirectory: $pwd\nGive a short fix and a next step."
    else
        prompt="次のコマンドが失敗した理由を説明して。\nコマンド: $cmd\n終了コード: $exit_code\nディレクトリ: $pwd\n短い修正案と次の一歩も教えて。"
    fi

    _sish_llm_call "$prompt"
}

_sish_llm_maybe_explain_last() {
    if [[ -z "${SISH_LLM_STARTUP_CHECKED:-}" ]]; then
        SISH_LLM_STARTUP_CHECKED=1
        if [[ "${SISH_LLM_AUTO_EXPLAIN:-0}" -eq 1 && -f "$HOME/.sish_last_fail" ]]; then
            line=$(<"$HOME/.sish_last_fail")
            rm -f "$HOME/.sish_last_fail"

            last_status="${line%%|*}"
            rest="${line#*|}"
            last_pwd="${rest%%|*}"
            last_cmd="${rest#*|}"

            SISH_LAST_STATUS="$last_status"
            SISH_LAST_PWD="$last_pwd"
            SISH_LAST_CMD="$last_cmd"
            _sish_llm_explain_last
        fi
    fi

    local exit_code=$?
    local cmd="$SISH_LAST_CMD"

    if [[ -z "$cmd" ]]; then
        return 0
    fi

    case "$cmd" in
        sish-llm*|llm*|sish-llm-explain* )
            return 0
            ;;
    esac

    if (( exit_code == 1 || exit_code == 2 )); then
        SISH_LAST_STATUS=$exit_code
        SISH_LAST_PWD="$PWD"

        local fail_file="$HOME/.sish_last_fail"
        print -r -- "$exit_code|$PWD|$cmd" > "$fail_file"

        if [[ "${SISH_LLM_AUTO_EXPLAIN:-0}" -eq 1 ]]; then
            _sish_llm_explain_last
        fi
    fi
}

_sish_llm_capture_preexec() {
    SISH_LAST_CMD="$1"
}

if [[ -o interactive ]]; then
    autoload -Uz add-zsh-hook 2>/dev/null
    add-zsh-hook preexec _sish_llm_capture_preexec 2>/dev/null || true
    add-zsh-hook precmd _sish_llm_maybe_explain_last 2>/dev/null || true
fi

# cd補正フック: ディレクトリが見つからないときに補正候補を表示
cd_with_correction() {
    builtin cd "$@" 2>/dev/null && return 0
    
    # cdが失敗した場合、補正候補を探す
    local target="$1"
    if [[ -n "$target" && "$target" != -* ]]; then
        # パスにスラッシュが含まれる場合（例: zsh-/Doc, zsh-5.6/Doc）
        if [[ "$target" == */* ]]; then
            local first_part="${target%%/*}"    # 最初の部分（例: zsh-）
            local rest_part="${target#*/}"      # 残りの部分（例: Doc）
            
            local -a first_candidates=()
            local dir
            for dir in "$PWD"/*; do
                if [[ -d "$dir" ]]; then
                    local dirname="${dir##*/}"
                    local first_lower="${first_part:l}"
                    local dirname_lower="${dirname:l}"
                    if [[ "$dirname" == "$first_part" ]] || \
                       [[ "$dirname_lower" == "$first_lower" ]] || \
                       [[ "$dirname_lower" == *"$first_lower"* ]] || \
                       [[ "$first_lower" == *"$dirname_lower"* ]] || \
                       [[ "$dirname_lower" =~ ^"$first_lower" ]] || \
                       [[ "$dirname_lower" =~ "$first_lower"$ ]]; then
                        first_candidates+=("$dir")
                    fi
                fi
            done
            
            # 最初の部分の候補が見つかった場合、残りのパスと結合
            if (( ${#first_candidates} >= 1 )); then
                local -a full_candidates=()
                for base in "${first_candidates[@]}"; do
                    local full_path="$base/$rest_part"
                    if [[ -d "$full_path" ]]; then
                        full_candidates+=("$full_path")
                    fi
                done
                
                if (( ${#full_candidates} == 1 )); then
                    echo "${full_candidates[1]}" > "/tmp/sish-last-dir-$$"
                    builtin cd "${full_candidates[1]}"
                    return $?
                elif (( ${#full_candidates} > 1 )); then
                    local cand="${full_candidates[1]}"
                    echo "$cand" > "/tmp/sish-last-dir-$$"
                    if type sish_msg >/dev/null 2>&1; then
                        sish_msg "dir_not_found_maybe" "$target" "${cand#$PWD/}"
                    else
                        print -r -- "Sish：お兄ちゃん！「$target」は無かったよ… もしかして「${cand#$PWD/}」のこと？"
                    fi
                    return 1
                fi
            fi
        fi
        
        # 通常のパス（スラッシュなし）
        local -a candidates=()
        local dir
        for dir in "$PWD"/*; do
            if [[ -d "$dir" ]]; then
                local dirname="${dir##*/}"
                local target_lower="${target:l}"
                local dirname_lower="${dirname:l}"
                if [[ "$dirname" == "$target" ]] || \
                   [[ "$dirname_lower" == "$target_lower" ]] || \
                   [[ "$dirname_lower" == *"$target_lower"* ]] || \
                   [[ "$target_lower" == *"$dirname_lower"* ]] || \
                   [[ "$dirname_lower" =~ ^"$target_lower" ]] || \
                   [[ "$dirname_lower" =~ "$target_lower"$ ]]; then
                    candidates+=("$dir")
                fi
            fi
        done
        
        if (( ${#candidates} == 1 )); then
            echo "${candidates[1]}" > "/tmp/sish-last-dir-$$"
            builtin cd "${candidates[1]}"
            return $?
        elif (( ${#candidates} > 1 )); then
            local cand="${candidates[1]}"
            echo "$cand" > "/tmp/sish-last-dir-$$"
            if type sish_msg >/dev/null 2>&1; then
                sish_msg "dir_not_found" "$target" "${cand##*/}"
                sish_msg "dir_similar_folders" "${cand##*/}"
                sish_msg "dir_hint"
            else
                print -r -- "Sish：お兄ちゃん！「$target」は無かったよ… 「${cand##*/}」の間違いじゃない？"
                print -r -- "       それっぽいフォルダ: ${cand##*/}"
                print -r -- "       ヒント: パスを確認してね！"
            fi
            return 1
        fi
    fi
    
    # 補正できなかった場合は元のエラーで返す
    builtin cd "$@"
    return $?
}

alias cd='cd_with_correction'

# ========================================
# Apt2Pacman変換機能
# ========================================
apt() {
    # 機能が無効なら通常のaptを実行
    if [[ "${SISH_APT2PACMAN_ENABLE:-0}" -ne 1 ]]; then
        command apt "$@"
        return $?
    fi
    
    if [[ $# -eq 0 ]]; then
        command apt
        return $?
    fi
    
    case "$1" in
        update|upgrade)
            echo "🔄 Sish: Converting 'apt $1' → 'pacman -Syu'"
            shift
            pacman -Syu "$@"
            ;;
        install)
            shift
            echo "📦 Sish: Converting 'apt install' → 'pacman -S'"
            pacman -S "$@"
            ;;
        remove|uninstall)
            shift
            echo "🗑️  Sish: Converting 'apt remove' → 'pacman -R'"
            pacman -R "$@"
            ;;
        search)
            shift
            echo "🔍 Sish: Converting 'apt search' → 'pacman -Ss'"
            pacman -Ss "$@"
            ;;
        *)
            echo "⚠️  Sish: Unknown apt command '$1', running as-is"
            command apt "$@"
            ;;
    esac
}

sudo() {
    # apt関連の場合のみ変換をチェック
    if [[ $# -ge 2 && "$1" == "apt" && "${SISH_APT2PACMAN_ENABLE:-0}" -eq 1 ]]; then
        shift
        case "$1" in
            update|upgrade)
                echo "🔄 Sish: Converting 'sudo apt $1' → 'sudo pacman -Syu'"
                shift
                command sudo pacman -Syu "$@"
                ;;
            install)
                shift
                echo "📦 Sish: Converting 'sudo apt install' → 'sudo pacman -S'"
                command sudo pacman -S "$@"
                ;;
            remove|uninstall)
                shift
                echo "🗑️  Sish: Converting 'sudo apt remove' → 'sudo pacman -R'"
                command sudo pacman -R "$@"
                ;;
            search)
                shift
                echo "🔍 Sish: Converting 'sudo apt search' → 'pacman -Ss'"
                pacman -Ss "$@"
                ;;
            *)
                echo "⚠️  Sish: Unknown apt command '$1', running as-is"
                command sudo apt "$@"
                ;;
        esac
    else
        command sudo "$@"
    fi
}

# 未定義コマンド提案を即実行
y() {
    local f="/tmp/sish-last-suggestion-$$"
    local pf=""
    [[ -n "${PPID:-}" ]] && pf="/tmp/sish-last-suggestion-$PPID"

    local pid_for_suggestion="$$"
    local df="/tmp/sish-last-dir-$$"  # ディレクトリ補正用
    local sug=""
    
    # パスタイポ補正フラグを優先チェック（ディレクトリ補正）
    if [[ -r "$df" ]]; then
        local target_dir="$(< "$df")"
        rm -f "$df" 2>/dev/null || true
        if [[ -d "$target_dir" ]]; then
            builtin cd -- "$target_dir"
            return $?
        fi
    fi
    
    if [[ -n "$pf" && -r "$pf" ]]; then
        pid_for_suggestion="$PPID"
        sug="$(< "$pf")"
        rm -f "$pf" 2>/dev/null || true
    elif [[ -r "$f" ]]; then
        sug="$(< "$f")"
        rm -f "$f" 2>/dev/null || true
    else
        sug="${SISH_LAST_SUGGESTION:-}"
    fi

    if [[ -n "$sug" ]]; then
        local -a words
        # Split like a shell command line, without evaluating it.
        words=( ${(z)sug} )
        if (( ${#words} == 0 )); then
            if type sish_msg >/dev/null 2>&1; then
                sish_msg "y_empty_suggestion"
            else
                print -r -- "Sish：お兄ちゃん、候補が空っぽだった…"
            fi
            return 1
        fi

        # If suggestion is only a command name, inherit args from the original command.
        # Example: `hit clone` -> suggestion `git` -> run `git clone`.
        if (( ${#words} == 1 )) && (( $# == 0 )); then
            local af="/tmp/sish-last-args-${pid_for_suggestion}"
            if [[ -r "$af" ]]; then
                local -a saved_args
                saved_args=( ${(f)"$(< "$af")"} )
                rm -f "$af" 2>/dev/null || true
                if (( ${#saved_args} )); then
                    "${words[@]}" "${saved_args[@]}"
                    return $?
                fi
            fi

            local prev
            prev="$(fc -ln -2 -2 2>/dev/null || true)"
            if [[ -n "$prev" ]]; then
                local -a prev_words
                prev_words=( ${(z)prev} )
                if (( ${#prev_words} >= 2 )); then
                    "${words[@]}" "${prev_words[@]:1}"
                    return $?
                fi
            fi
        fi

        "${words[@]}" "$@"
    else
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "y_no_suggestion"
        else
            print -r -- "Sish：お兄ちゃん、いま実行できる候補が無いよ…"
        fi
        return 1
    fi
}

# --- Path fixups for famous commands ---
_sish_first_existing_candidate() {
    setopt local_options NULL_GLOB NO_CASE_GLOB
    local base="$1"
    local -a cands
    # Prefer exact-with-extension (README -> README.md etc), then prefix.
    # Try current dir, then one and two levels up.
    local -a prefixes
    prefixes=("" "../" "../../")
    local p
    for p in "${prefixes[@]}"; do
        cands=( ${p}${base}.* )
        if (( ${#cands} == 0 )); then
            cands=( ${p}${base}* )
        fi
        if (( ${#cands} )); then
            print -r -- "${cands[1]}"
            return 0
        fi
    done
    if (( ${#cands} )); then
        print -r -- "${cands[1]}"
        return 0
    fi
    return 1
}

cat() {
    local -a opts files
    local a
    for a in "$@"; do
        if [[ "$a" == -* ]]; then
            opts+=("$a")
        else
            files+=("$a")
        fi
    done

    if (( ${#files} == 1 )) && [[ ! -e "${files[1]}" ]]; then
        local cand
        cand="$(_sish_first_existing_candidate "${files[1]}")" || {
            command cat "$@"
            return $?
        }
        # Suggest running the corrected path via `y`.
        if (( ${#opts} )); then
            SISH_LAST_SUGGESTION="cat ${(j: :)${(q)opts}} ${(q)cand}"
        else
            SISH_LAST_SUGGESTION="cat ${(q)cand}"
        fi
        # Use the same per-process temp file that `y` consumes, to avoid stale suggestions.
        print -r -- "$SISH_LAST_SUGGESTION" >| "/tmp/sish-last-suggestion-$$" 2>/dev/null || true
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "void_file_not_found" "${files[1]}" "$cand"
        else
            print -r -- "Sish：お兄ちゃん！\"${files[1]}\" は無かったよ… もしかして\"$cand\" のこと？"
        fi
        return 1
    fi

    command cat "$@"
}

# 便利コマンド（デフォルト）
summon() { command git clone -- "$@"; }

void() {
    if [[ $# -lt 1 ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "void_usage"
        else
            print -r -- "Sish：お兄ちゃん、voidは消したいパスを指定してね！（例: void ./tmp）"
        fi
        return 2
    fi
    if [[ "$1" == "/" ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "void_root_warning"
        else
            print -r -- "Sish：それはダメ！ '/' は消しちゃだめ！"
        fi
        return 1
    fi
    command rm -rf -- "$@"
}

fiat() {
    if (( EUID == 0 )); then
        command -- "$@"
    else
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "fiat_using_sudo"
        else
            print -r -- "Sish：お兄ちゃん、fiatはSishが管理者で動いてる時だけパスワードレスだよ…（sudoで実行するね）"
        fi
        command sudo -- "$@"
    fi
}

gaze() { command ls -lahFt --color=auto -- "$@"; }

lore() {
    if [[ $# -ne 1 ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "lore_usage"
        else
            print -r -- "Sish：loreは1つだけ指定してね！（例: lore myfile）"
        fi
        return 2
    fi
    command cp -a -- "$1" "$1.back"
}

node() {
    if [[ $# -lt 1 ]]; then
        if type sish_msg >/dev/null 2>&1; then
            sish_msg "node_usage"
        else
            print -r -- "Sish：nodeは2つの候補ディレクトリを渡してね！（例: node hoge foo）"
        fi
        return 2
    fi
    if [[ -d "$1" ]]; then
        builtin cd -- "$1"
        return $?
    fi
    if [[ $# -ge 2 && -d "$2" ]]; then
        builtin cd -- "$2"
        return $?
    fi
    if type sish_msg >/dev/null 2>&1; then
        sish_msg "node_not_directory"
    else
        print -r -- "Sish：お兄ちゃん、どっちもフォルダじゃなかった…"
    fi
    return 1
}

alias ls='ls --color=auto -F'
alias ll='ls --color=auto -lahF'
alias la='ls --color=auto -A'
alias ..='cd ..'
alias g='git'
alias py='python3'

# カスタムコマンド（簡単に追加できる）
# 例: ~/.sish/commands.zsh や ~/.sish/commands.d/*.zsh
if [[ -f ~/.sish/commands.zsh ]]; then
    source ~/.sish/commands.zsh
fi
if [[ -d ~/.sish/commands.d ]]; then
    for f in ~/.sish/commands.d/*.zsh(N); do
        source "$f"
    done
fi

EOFRC

# Replace the placeholder with actual i18n path
I18N_FILE="$SCRIPT_DIR/config/sish_i18n.zsh"
if [[ -f "$I18N_FILE" ]]; then
    sed -i "s|SISH_I18N_PATH_PLACEHOLDER|$I18N_FILE|g" "$DOTDIR/.zshrc"
fi

if [[ -f "$SISH_CONFIG" ]]; then
    cat "$SISH_CONFIG" >> "$DOTDIR/.zshrc"
fi

if [[ -f "$HOME/.sishrc" ]]; then
    cat "$HOME/.sishrc" >> "$DOTDIR/.zshrc"
fi

cat >> "$DOTDIR/.zshrc" << 'EOFRC_OVERRIDES'
# Re-apply environment overrides after config loads
for var in "${(@k)sish_env_overrides}"; do
    # Skip readonly zsh variables
    [[ "$var" == "status" ]] && continue
    export "$var=${sish_env_overrides[$var]}" 2>/dev/null || true
done
EOFRC_OVERRIDES

export ZDOTDIR="$DOTDIR"

# Provide module directory to the embedded zsh via env var.
SISH_ZSH_MODULE_DIR=""
if [[ -d "$SCRIPT_DIR/zsh-5.9/install/lib/zsh/5.9" ]]; then
    SISH_ZSH_MODULE_DIR="$SCRIPT_DIR/zsh-5.9/install/lib/zsh/5.9"
fi
export SISH_ZSH_MODULE_DIR

# argv[0] を "Sish" にして、メッセージの見た目も統一する
# NOTE: zshは非対話モードでは .zshrc を読まないが、Sishは常に読ませたいので、
#       -c でも ZDOTDIR の .zshrc を source するコードを前置する
is_non_interactive=0
has_dash_c=0
for a in "$@"; do
    if [[ "$a" == "-c" ]]; then
        has_dash_c=1
        is_non_interactive=1
        break
    elif [[ "$a" == "--help" || "$a" == "--version" ]]; then
        is_non_interactive=1
        break
    fi
done

if [[ $has_dash_c -eq 1 ]]; then
    # -c の引数を取り出して、その前に .zshrc を source する新しいコマンドを構築
    shift_count=0
    for a in "$@"; do
        shift_count=$((shift_count + 1))
        if [[ "$a" == "-c" ]]; then
            break
        fi
    done
    # 残りの引数を取得（-c の次が実行するコマンド）
    cmd_to_run=""
    cmd_idx=0
    for a in "$@"; do
        cmd_idx=$((cmd_idx + 1))
        if [[ $cmd_idx -gt $shift_count ]]; then
            cmd_to_run="$a"
            break
        fi
    done
    # .zshrc を source してから元のコマンドを実行
    wrapped_cmd="[[ -f \$ZDOTDIR/.zshrc ]] && source \$ZDOTDIR/.zshrc; $cmd_to_run"
    exec -a Sish "$SISH_PATH" -c "$wrapped_cmd"
elif [[ $is_non_interactive -eq 1 ]]; then
    exec -a Sish "$SISH_PATH" "$@"
else
    exec -a Sish "$SISH_PATH" -i "$@"
fi
