#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

DEFAULT_INSTALLED_SISH_PATH="/tmp/sish-test/bin/zsh"
DEFAULT_BUILT_SISH_PATH="$SCRIPT_DIR/zsh-5.9/Src/zsh"

# Allow overriding the zsh binary path.
# Prefer an explicit env var, then in-repo build artifact, then the historical /tmp install path.
SISH_PATH="${SISH_PATH:-}"
if [[ -z "$SISH_PATH" ]]; then
    if [[ -x "$DEFAULT_BUILT_SISH_PATH" ]]; then
        SISH_PATH="$DEFAULT_BUILT_SISH_PATH"
    else
        SISH_PATH="$DEFAULT_INSTALLED_SISH_PATH"
    fi
fi
SISH_CONFIG="$SCRIPT_DIR/config/sishrc"

if [[ ! -x "$SISH_PATH" ]]; then
    echo "Sish: 実行ファイルが見つからないよ: $SISH_PATH" >&2
    echo "ヒント: $SCRIPT_DIR/zsh-5.9 で make を実行してね（または SISH_PATH=/path/to/zsh を設定）" >&2
    exit 127
fi

# zshは「rcファイルのパスを引数で渡す」仕様ではないので、
# ZDOTDIRに隔離した .zshrc を用意して、対話シェルとして起動する。
DOTDIR="$(mktemp -d)"
cleanup() {
    rm -rf "$DOTDIR" 2>/dev/null || true
}
trap cleanup EXIT

cat > "$DOTDIR/.zshrc" << 'EOFRC'
# Sish temporary .zshrc (isolated via ZDOTDIR)

# 環境変数で既に設定されている値を保護
typeset -A sish_env_overrides
for var in SISH_TONE SISH_THEME SISH_ERROR_VERBOSITY \
           SISH_CHAR_NAME SISH_CHAR_EXPRESSION SISH_CHAR_POSITION SISH_CHAR_SIZE SISH_CHAR_ANIMATION \
           SISH_COMPLETION_ENABLE SISH_COMPLETION_FUZZY SISH_COMPLETION_MAX_CANDIDATES \
           SISH_COMPLETION_DIR_SIMILARITY SISH_COMPLETION_HISTORY \
           SISH_LLM_ENABLE SISH_LLM_ENDPOINT SISH_LLM_MODEL SISH_LLM_MAX_TOKENS \
           SISH_GUI_ENABLE SISH_GUI_SOCKET_PATH SISH_GUI_AUTOSTART SISH_GUI_EXPRESSION_SYNC; do
    if [[ -n "${(P)var:-}" ]]; then
        sish_env_overrides[$var]="${(P)var}"
    fi
done

# Load user's sishrc first to get SISH_TONE early
if [[ -f "$HOME/.sishrc" ]]; then
    source "$HOME/.sishrc"
fi

# 環境変数で指定された値で上書き
for var in "${(@k)sish_env_overrides}"; do
    export "$var=${sish_env_overrides[$var]}"
done

setopt AUTO_CD
unsetopt CORRECT
unsetopt CORRECTALL
setopt NOCORRECT
setopt HIST_IGNORE_DUPS
setopt SHARE_HISTORY

HISTFILE=~/.sish_history
HISTSIZE=10000
SAVEHIST=10000

PROMPT='%F{213}Sish%f:%F{111}%~%f %# '

# 補完（Tab）
autoload -Uz compinit
compinit -d ~/.sish_compdump 2>/dev/null || true

# cd補正フック: ディレクトリが見つからないときに補正候補を表示
cd_with_correction() {
    builtin cd "$@" 2>/dev/null && return 0
    
    # cdが失敗した場合、補正候補を探す
    local target="$1"
    if [[ -n "$target" && "$target" != -* ]]; then
        # パスにスラッシュが含まれる場合（例: zsh-/Doc, zsh-5.6/Doc）
        if [[ "$target" == */* ]]; then
            local first_part="${target%%/*}"    # 最初の部分（例: zsh-）
            local rest_part="${target#*/}"      # 残りの部分（例: Doc）
            
            local -a first_candidates=()
            local dir
            for dir in "$PWD"/*; do
                if [[ -d "$dir" ]]; then
                    local dirname="${dir##*/}"
                    local first_lower="${first_part:l}"
                    local dirname_lower="${dirname:l}"
                    if [[ "$dirname" == "$first_part" ]] || \
                       [[ "$dirname_lower" == "$first_lower" ]] || \
                       [[ "$dirname_lower" == *"$first_lower"* ]] || \
                       [[ "$first_lower" == *"$dirname_lower"* ]] || \
                       [[ "$dirname_lower" =~ ^"$first_lower" ]] || \
                       [[ "$dirname_lower" =~ "$first_lower"$ ]]; then
                        first_candidates+=("$dir")
                    fi
                fi
            done
            
            # 最初の部分の候補が見つかった場合、残りのパスと結合
            if (( ${#first_candidates} >= 1 )); then
                local -a full_candidates=()
                for base in "${first_candidates[@]}"; do
                    local full_path="$base/$rest_part"
                    if [[ -d "$full_path" ]]; then
                        full_candidates+=("$full_path")
                    fi
                done
                
                if (( ${#full_candidates} == 1 )); then
                    echo "${full_candidates[1]}" > "/tmp/sish-last-dir-$$"
                    builtin cd "${full_candidates[1]}"
                    return $?
                elif (( ${#full_candidates} > 1 )); then
                    local cand="${full_candidates[1]}"
                    echo "$cand" > "/tmp/sish-last-dir-$$"
                    print -r -- "Sish：お兄ちゃん！「$target」は無かったよ… もしかして「${cand#$PWD/}」のこと？"
                    return 1
                fi
            fi
        fi
        
        # 通常のパス（スラッシュなし）
        local -a candidates=()
        local dir
        for dir in "$PWD"/*; do
            if [[ -d "$dir" ]]; then
                local dirname="${dir##*/}"
                local target_lower="${target:l}"
                local dirname_lower="${dirname:l}"
                if [[ "$dirname" == "$target" ]] || \
                   [[ "$dirname_lower" == "$target_lower" ]] || \
                   [[ "$dirname_lower" == *"$target_lower"* ]] || \
                   [[ "$target_lower" == *"$dirname_lower"* ]] || \
                   [[ "$dirname_lower" =~ ^"$target_lower" ]] || \
                   [[ "$dirname_lower" =~ "$target_lower"$ ]]; then
                    candidates+=("$dir")
                fi
            fi
        done
        
        if (( ${#candidates} == 1 )); then
            echo "${candidates[1]}" > "/tmp/sish-last-dir-$$"
            builtin cd "${candidates[1]}"
            return $?
        elif (( ${#candidates} > 1 )); then
            local cand="${candidates[1]}"
            echo "$cand" > "/tmp/sish-last-dir-$$"
            print -r -- "Sish：お兄ちゃん！「$target」は無かったよ… 「${cand##*/}」の間違いじゃない？"
            print -r -- "       それっぽいフォルダ: ${cand##*/}"
            print -r -- "       ヒント: パスを確認してね！"
            return 1
        fi
    fi
    
    # 補正できなかった場合は元のエラーで返す
    builtin cd "$@"
    return $?
}

alias cd='cd_with_correction'

# 未定義コマンド提案を即実行
y() {
    local f="/tmp/sish-last-suggestion-$$"
    local af="/tmp/sish-last-args-$$"
    local df="/tmp/sish-last-dir-$$"  # ディレクトリ補正用
    local sug=""
    
    # パスタイポ補正フラグを優先チェック（ディレクトリ補正）
    if [[ -r "$df" ]]; then
        local target_dir="$(< "$df")"
        rm -f "$df" 2>/dev/null || true
        if [[ -d "$target_dir" ]]; then
            builtin cd -- "$target_dir"
            return $?
        fi
    fi
    
    if [[ -r "$f" ]]; then
        sug="$(< "$f")"
        rm -f "$f" 2>/dev/null || true
    else
        sug="${SISH_LAST_SUGGESTION:-}"
    fi

    if [[ -n "$sug" ]]; then
        local -a words
        # Split like a shell command line, without evaluating it.
        words=( ${(z)sug} )
        if (( ${#words} == 0 )); then
            print -r -- "Sish：お兄ちゃん、候補が空っぽだった…"
            return 1
        fi

        # If suggestion is only a command name, inherit args from the original command.
        # Example: `hit clone` -> suggestion `git` -> run `git clone`.
        if (( ${#words} == 1 )) && (( $# == 0 )); then
            if [[ -r "$af" ]]; then
                local -a saved_args
                saved_args=( ${(f)"$(< "$af")"} )
                rm -f "$af" 2>/dev/null || true
                if (( ${#saved_args} )); then
                    command "${words[@]}" "${saved_args[@]}"
                    return $?
                fi
            fi

            local prev
            prev="$(fc -ln -2 -2 2>/dev/null || true)"
            if [[ -n "$prev" ]]; then
                local -a prev_words
                prev_words=( ${(z)prev} )
                if (( ${#prev_words} >= 2 )); then
                    command "${words[@]}" "${prev_words[@]:1}"
                    return $?
                fi
            fi
        fi

        command "${words[@]}" "$@"
    else
        print -r -- "Sish：お兄ちゃん、いま実行できる候補が無いよ…"
        return 1
    fi
}

# --- Path fixups for famous commands ---
_sish_first_existing_candidate() {
    setopt local_options NULL_GLOB NO_CASE_GLOB
    local base="$1"
    local -a cands
    # Prefer exact-with-extension (README -> README.md etc), then prefix.
    # Try current dir, then one and two levels up.
    local -a prefixes
    prefixes=("" "../" "../../")
    local p
    for p in "${prefixes[@]}"; do
        cands=( ${p}${base}.* )
        if (( ${#cands} == 0 )); then
            cands=( ${p}${base}* )
        fi
        if (( ${#cands} )); then
            print -r -- "${cands[1]}"
            return 0
        fi
    done
    if (( ${#cands} )); then
        print -r -- "${cands[1]}"
        return 0
    fi
    return 1
}

cat() {
    local -a opts files
    local a
    for a in "$@"; do
        if [[ "$a" == -* ]]; then
            opts+=("$a")
        else
            files+=("$a")
        fi
    done

    if (( ${#files} == 1 )) && [[ ! -e "${files[1]}" ]]; then
        local cand
        cand="$(_sish_first_existing_candidate "${files[1]}")" || {
            command cat "$@"
            return $?
        }
        # Suggest running the corrected path via `y`.
        if (( ${#opts} )); then
            SISH_LAST_SUGGESTION="cat ${(j: :)${(q)opts}} ${(q)cand}"
        else
            SISH_LAST_SUGGESTION="cat ${(q)cand}"
        fi
        # Use the same per-process temp file that `y` consumes, to avoid stale suggestions.
        print -r -- "$SISH_LAST_SUGGESTION" >| "/tmp/sish-last-suggestion-$$" 2>/dev/null || true
        print -r -- "Sish：お兄ちゃん！\"${files[1]}\" は無かったよ… もしかして\"$cand\" のこと？"
        return 1
    fi

    command cat "$@"
}

# 便利コマンド（デフォルト）
summon() { command git clone -- "$@"; }

void() {
    if [[ $# -lt 1 ]]; then
        print -r -- "Sish：お兄ちゃん、voidは消したいパスを指定してね！（例: void ./tmp）"
        return 2
    fi
    if [[ "$1" == "/" ]]; then
        print -r -- "Sish：それはダメ！ '/' は消しちゃだめ！"
        return 1
    fi
    command rm -rf -- "$@"
}

fiat() {
    if (( EUID == 0 )); then
        command -- "$@"
    else
        print -r -- "Sish：お兄ちゃん、fiatはSishが管理者で動いてる時だけパスワードレスだよ…（sudoで実行するね）"
        command sudo -- "$@"
    fi
}

gaze() { command ls -lahFt --color=auto -- "$@"; }

lore() {
    if [[ $# -ne 1 ]]; then
        print -r -- "Sish：loreは1つだけ指定してね！（例: lore myfile）"
        return 2
    fi
    command cp -a -- "$1" "$1.back"
}

node() {
    if [[ $# -lt 1 ]]; then
        print -r -- "Sish：nodeは2つの候補ディレクトリを渡してね！（例: node hoge foo）"
        return 2
    fi
    if [[ -d "$1" ]]; then
        builtin cd -- "$1"
        return $?
    fi
    if [[ $# -ge 2 && -d "$2" ]]; then
        builtin cd -- "$2"
        return $?
    fi
    print -r -- "Sish：お兄ちゃん、どっちもフォルダじゃなかった…"
    return 1
}

alias ls='ls --color=auto -F'
alias ll='ls --color=auto -lahF'
alias la='ls --color=auto -A'
alias ..='cd ..'
alias g='git'
alias py='python3'

# カスタムコマンド（簡単に追加できる）
# 例: ~/.sish/commands.zsh や ~/.sish/commands.d/*.zsh
if [[ -f ~/.sish/commands.zsh ]]; then
    source ~/.sish/commands.zsh
fi
if [[ -d ~/.sish/commands.d ]]; then
    for f in ~/.sish/commands.d/*.zsh(N); do
        source "$f"
    done
fi

# 対話モードのみウェルカムメッセージを表示
if [[ -o interactive ]]; then
    echo "🌸 Sish - Sister Shell"
    echo "💡 ヒント: sish-config で設定メニュー"
    echo ""
fi
EOFRC

if [[ -f "$SISH_CONFIG" ]]; then
    cat "$SISH_CONFIG" >> "$DOTDIR/.zshrc"
fi

export ZDOTDIR="$DOTDIR"

# argv[0] を "Sish" にして、メッセージの見た目も統一する
# NOTE: zshは非対話モードでは .zshrc を読まないが、Sishは常に読ませたいので、
#       -c でも ZDOTDIR の .zshrc を source するコードを前置する
is_non_interactive=0
has_dash_c=0
for a in "$@"; do
    if [[ "$a" == "-c" ]]; then
        has_dash_c=1
        is_non_interactive=1
        break
    elif [[ "$a" == "--help" || "$a" == "--version" ]]; then
        is_non_interactive=1
        break
    fi
done

if [[ $has_dash_c -eq 1 ]]; then
    # -c の引数を取り出して、その前に .zshrc を source する新しいコマンドを構築
    shift_count=0
    for a in "$@"; do
        shift_count=$((shift_count + 1))
        if [[ "$a" == "-c" ]]; then
            break
        fi
    done
    # 残りの引数を取得（-c の次が実行するコマンド）
    cmd_to_run=""
    cmd_idx=0
    for a in "$@"; do
        cmd_idx=$((cmd_idx + 1))
        if [[ $cmd_idx -gt $shift_count ]]; then
            cmd_to_run="$a"
            break
        fi
    done
    # .zshrc を source してから元のコマンドを実行
    wrapped_cmd="[[ -f \$ZDOTDIR/.zshrc ]] && source \$ZDOTDIR/.zshrc; $cmd_to_run"
    exec -a Sish "$SISH_PATH" -c "$wrapped_cmd"
elif [[ $is_non_interactive -eq 1 ]]; then
    exec -a Sish "$SISH_PATH" "$@"
else
    exec -a Sish "$SISH_PATH" -i "$@"
fi
